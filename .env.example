# Copy to .env (in the project root). Read by both backend/ and bot/.

# From @BotFather. Leave empty to run the web app without Telegram (alerts are logged instead).
TELEGRAM_BOT_TOKEN=
# Optional: auto-detected from the token if empty
TELEGRAM_BOT_USERNAME=

# Where the bot reaches the API, and the web URL used in links
BLOODLINK_API_URL=http://localhost:8000/api
BLOODLINK_WEB_URL=http://localhost:5173

# Insert demo data when the database is empty (1 = yes)
AUTO_SEED=1
# BLOODLINK_DB_URL=sqlite:///./bloodlink.db
